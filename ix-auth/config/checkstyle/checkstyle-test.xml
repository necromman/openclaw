<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Test source set 전용 Checkstyle config — main 의 strict 에서 JUnit 일반 관행 만 명시 완화.

  완화 항목 (main 과 다른 부분):
  - AvoidStarImport 제거 — `import static org.assertj.core.api.Assertions.*` / `org.mockito.Mockito.*` 등 JUnit 관행 허용
  - MethodName 패턴 변경 — `should_return_X_when_Y` 같은 underscore method name 허용 (JUnit DisplayName 보완용)
  - TypeName 패턴 변경 — `class List_` 같은 keyword 회피 underscore 끝 허용 (java.util 충돌 피하는 inner class 패턴)
  - MethodLength max 150 — setUp / 통합 시나리오 메서드가 build chain 으로 길어지는 경우 허용
  - LeftCurly 제거 — `void test() { code(); }` 한 줄 inline body 의 `{` 위치 검사 제외
  - NeedBraces 제거 — `if (x == null) throw ...;` 같은 짧은 가드 한 줄 허용 (test setUp 가드 패턴)

  나머지 (Whitespace / UnusedImports / FileTabCharacter 등) 는 main 과 동일 strict.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>

  <module name="TreeWalker">
    <!-- Naming — MethodName 만 underscore 허용 (JUnit 관행), 나머지는 main 동일 -->
    <module name="ConstantName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="MethodName">
      <property name="format" value="^[a-zA-Z_][a-zA-Z0-9_]*$"/>
    </module>
    <module name="PackageName"/>
    <module name="ParameterName"/>
    <module name="TypeName">
      <property name="format" value="^[A-Z][a-zA-Z0-9_]*$"/>
    </module>

    <!-- Imports — AvoidStarImport 제거 (assertj/mockito static import .* 허용) -->
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>

    <!-- Size — MethodLength 더 큼 (test 의 setUp / 통합 시나리오 builder chain 허용) -->
    <module name="MethodLength">
      <property name="max" value="150"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="12"/>
      <property name="tokens" value="METHOD_DEF"/>
    </module>

    <!-- Whitespace -->
    <module name="WhitespaceAround"/>
    <module name="NoWhitespaceAfter"/>
    <module name="NoWhitespaceBefore"/>

    <!-- Blocks — LeftCurly + NeedBraces 제거 (test inline body + 짧은 가드 한 줄 허용) -->
    <module name="RightCurly"/>

    <!-- Coding -->
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="MissingSwitchDefault"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- Misc -->
    <module name="ArrayTypeStyle"/>
    <module name="UpperEll"/>
  </module>

  <!-- File-level checks (main 동일) -->
  <module name="FileTabCharacter"/>
  <module name="NewlineAtEndOfFile">
    <property name="lineSeparator" value="lf_cr_crlf"/>
  </module>

  <!-- suppressions.xml 의 service/SamlIdpService 제외는 main 만 영향 — test 는 적용 안 됨 -->
</module>
