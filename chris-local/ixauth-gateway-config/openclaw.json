{
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "ix-auth",
      "ixAuth": {
        "baseUrl": "http://ix-auth:9100",
        "serviceKey": "${IXAUTH_SERVICE_KEY}",
        "issuer": "openclaw-ix-auth",
        "audience": "openclaw-gateway",
        "selfSignup": "__OPENCLAW_SELF_SIGNUP__",
        "session": {
          "idleTimeoutMinutes": 30,
          "absoluteTimeoutHours": 12
        }
      }
    },
    "controlUi": {
      "allowedOrigins": [
        "__OPENCLAW_PUBLIC_ORIGIN__"
      ]
    },
    "trustedProxies": "__OPENCLAW_TRUSTED_PROXIES__",
    "roles": {
      "default": "member",
      "definitions": {
        "superadmin": {
          "sessions": {
            "others": "write"
          },
          "agents": "*",
          "scopes": [
            "operator.admin"
          ]
        },
        "admin": {
          "sessions": {
            "others": "write"
          },
          "agents": "*",
          "scopes": [
            "operator.read",
            "operator.write",
            "operator.approvals",
            "operator.questions"
          ]
        },
        "executive": {
          "sessions": {
            "others": "view"
          },
          "agents": "*",
          "scopes": [
            "operator.read",
            "operator.write",
            "operator.questions"
          ]
        },
        "moderator": {
          "sessions": {
            "others": "none"
          },
          "agents": "*",
          "scopes": [
            "operator.read",
            "operator.write",
            "operator.approvals",
            "operator.questions"
          ]
        },
        "member": {
          "sessions": {
            "others": "none"
          },
          "agents": "*",
          "scopes": [
            "operator.read",
            "operator.write",
            "operator.questions"
          ]
        }
      }
    }
  },
  "tools": {
    "sessions": {
      "visibility": "self"
    },
    "fs": {
      "workspaceOnly": true
    }
  },
  "plugins": {
    "entries": {
      "codex": {
        "enabled": true,
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "anthropic": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.6-luna",
        "fallbacks": [
          "anthropic/claude-sonnet-5"
        ]
      },
      "modelPolicy": {
        "allow": [
          "openai/gpt-5.6-luna",
          "anthropic/claude-sonnet-5"
        ]
      },
      "systemAgent": {
        "agentId": "main"
      }
    },
    "entries": {
      "main": {
        "name": "공용",
        "description": "회사 공용 AI 비서",
        "identity": {
          "name": "공용"
        }
      }
    }
  },
  "memory": {
    "citations": "on",
    "search": {
      "provider": "none",
      "store": {
        "fts": {
          "tokenizer": "trigram"
        }
      }
    }
  },
  "talk": {
    "agentId": "main"
  }
}
