{
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "ix-auth",
      "ixAuth": {
        "baseUrl": "http://ix-auth:9100",
        "serviceKey": "${IXAUTH_SERVICE_KEY}",
        "issuer": "openclaw-ix-auth",
        "audience": "openclaw-gateway",
        "selfSignup": "__OPENCLAW_SELF_SIGNUP__",
        "session": {
          "idleTimeoutMinutes": 30,
          "absoluteTimeoutHours": 12
        }
      }
    },
    "controlUi": {
      "allowedOrigins": [
        "__OPENCLAW_PUBLIC_ORIGIN__"
      ]
    },
    "trustedProxies": "__OPENCLAW_TRUSTED_PROXIES__",
    "nodes": {
      "browser": {
        "mode": "off"
      }
    },
    "roles": {
      "default": "member",
      "definitions": {
        "superadmin": {
          "sessions": {
            "others": "write"
          },
          "agents": "*",
          "scopes": [
            "operator.admin"
          ]
        },
        "admin": {
          "sessions": {
            "others": "write"
          },
          "agents": "*",
          "scopes": [
            "operator.read",
            "operator.write",
            "operator.approvals",
            "operator.questions"
          ]
        },
        "executive": {
          "sessions": {
            "others": "view"
          },
          "agents": "*",
          "scopes": [
            "operator.read",
            "operator.write",
            "operator.questions"
          ]
        },
        "moderator": {
          "sessions": {
            "others": "none"
          },
          "agents": "*",
          "scopes": [
            "operator.read",
            "operator.write",
            "operator.approvals",
            "operator.questions"
          ]
        },
        "member": {
          "sessions": {
            "others": "none"
          },
          "agents": "*",
          "scopes": [
            "operator.read",
            "operator.write",
            "operator.questions"
          ]
        }
      }
    }
  },
  "tools": {
    "sessions": {
      "visibility": "department"
    },
    "fs": {
      "workspaceOnly": true
    }
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "noSandbox": true
  },
  "plugins": {
    "entries": {
      "codex": {
        "enabled": false
      },
      "anthropic": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      }
    }
  },
  "models": {
    "providers": {
      "anthropic": {
        "headers": {
          "user-agent": "claude-cli/2.1.251"
        }
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-5"
      },
      "modelPolicy": {
        "allow": [
          "anthropic/claude-sonnet-5",
          "anthropic/claude-opus-5",
          "anthropic/claude-haiku-4-5",
          "anthropic/claude-fable-5",
          "anthropic/claude-fable-5-1",
          "anthropic/claude-opus-4-6",
          "anthropic/claude-opus-4-7",
          "anthropic/claude-opus-4-8",
          "anthropic/claude-sonnet-4-6"
        ]
      },
      "systemAgent": {
        "agentId": "main"
      }
    },
    "entries": {
      "main": {
        "name": "공용",
        "description": "회사 공용 AI 비서",
        "workspace": "/home/node/.openclaw/workspace",
        "identity": {
          "name": "공용"
        },
        "tools": {
          "deny": [
            "sessions_list",
            "sessions_history",
            "sessions_search",
            "sessions_send"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": ["/mnt/knowledge"]
          }
        }
      },
      "ageo": {
        "name": "AGEO 에이전트",
        "description": "진바이오테크 라포르몰 제품의 검색 답변엔진(네이버 AI 브리핑, ChatGPT, Gemini) 노출 최적화 전담 에이전트",
        "workspace": "/home/node/.openclaw/workspace-ageo",
        "identity": {
          "name": "AGEO 에이전트"
        },
        "model": {
          "primary": "anthropic/claude-opus-5"
        },
        "thinkingDefault": "medium",
        "modelPolicy": {
          "allow": [
            "anthropic/claude-opus-5",
            "anthropic/claude-sonnet-5"
          ]
        },
        "tools": {
          "profile": "coding",
          "permissionMode": "workspace",
          "alsoAllow": ["browser"],
          "deny": [
            "sessions_list",
            "sessions_history",
            "sessions_search",
            "sessions_send"
          ]
        },
        "memory": {
          "search": {
            "extraPaths": ["/mnt/knowledge"]
          }
        }
      }
    }
  },
  "memory": {
    "citations": "on",
    "search": {
      "provider": "none",
      "store": {
        "fts": {
          "tokenizer": "trigram"
        }
      }
    }
  },
  "talk": {
    "agentId": "main"
  }
}
