# Copy to chris-local/ixauth.env and fill in. That file is git-ignored
# (.gitignore rule "chris-local/ixauth.env").
#
# Generate the two secrets with:
#   openssl rand -base64 36 | tr -d '\n'
#
# Full table with descriptions: chris-local/DEPLOY.md.

# ── PostgreSQL ──
IXAUTH_DB_NAME=ixauth
IXAUTH_DB_USERNAME=ixauth
IXAUTH_DB_PASSWORD=

# ── IX-Auth ──
# 32 characters or more. The identity server refuses to boot with a shorter key.
# This is the app-to-server shared secret; it never reaches a browser.
IXAUTH_SERVICE_KEY=

# Seeded on first boot only, and granted SUPERADMIN. The password must satisfy the
# policy below (length, one upper case letter, one digit, one symbol).
# Change it from the console after the first sign-in: IX-Auth has no "must change
# password on first login" flag, so this is an operating instruction, not a control.
IXAUTH_ADMIN_EMAIL=admin@example.com
IXAUTH_ADMIN_PASSWORD=
IXAUTH_ADMIN_NAME=관리자

IXAUTH_PASSWORD_MIN_LENGTH=10
IXAUTH_LOG_LEVEL=INFO

# CLOSED keeps self-service signup off and leaves account creation to administrators.
# OPEN or APPROVAL need working mail first. This one variable also decides whether the
# Control UI shows a signup screen at all, so the two sides cannot disagree.
IXAUTH_ACCOUNT_SIGNUP_MODE=CLOSED
# EMAIL sends a confirmation link before an account counts as verified. NONE skips it
# and is only defensible where the address is already known to be real.
IXAUTH_ACCOUNT_SIGNUP_VERIFICATION=EMAIL
# Empty allows any address. "prost.team,example.com" restricts signup to those domains.
IXAUTH_ACCOUNT_SIGNUP_ALLOWED_DOMAINS=
# Invitation link lifetime. Three days survives a weekend without leaving a forwarded
# invitation usable for a week.
IXAUTH_ACCOUNT_INVITE_TOKEN_TTL=72h

# ── Mail ──
# WEBHOOK: no mail server. The identity server hands each message to the Gateway, which
#   keeps the invitation link so an administrator can copy it out of the invitation
#   screen and pass it on. Everything else is discarded unread.
# SMTP: real delivery. Invitations and verification links are mailed, and the Gateway
#   keeps nothing. Required before IXAUTH_ACCOUNT_SIGNUP_MODE leaves CLOSED.
# LOG: development only. The message is written to the identity server log.
IXAUTH_MAIL_TRANSPORT=WEBHOOK
IXAUTH_MAIL_FROM=no-reply@localhost
IXAUTH_MAIL_PRODUCT_NAME=Chris Agent
# Only read when the transport is WEBHOOK. This is the Gateway address on the compose
# network, not the browser origin.
IXAUTH_MAIL_WEBHOOK_URL=http://gateway:18789/auth/mail-hook
# Only read when the transport is SMTP. With the mail profile started
# (docker compose --profile mail up -d) the development inbox is host=mailpit port=1025,
# readable at http://127.0.0.1:18025.
IXAUTH_MAIL_SMTP_HOST=
IXAUTH_MAIL_SMTP_PORT=587
IXAUTH_MAIL_SMTP_USERNAME=
IXAUTH_MAIL_SMTP_PASSWORD=
IXAUTH_MAIL_SMTP_STARTTLS=true
MAILPIT_UI_PORT=18025

# ── Gateway ──
# Host port. 18789 is left free for a locally installed Gateway.
OPENCLAW_GATEWAY_PORT=18800

# The exact origin the browser uses, scheme and port included, with no trailing slash.
# It lands in gateway.controlUi.allowedOrigins. A mismatch shows up as 403
# origin_not_allowed on sign-in, or as a Control UI that never finishes connecting.
OPENCLAW_PUBLIC_ORIGIN=http://127.0.0.1:18800

OPENCLAW_TZ=Asia/Seoul

# ── NAS 부서 공유 ──
# Parent directory of the department shares, on the host. The compose file bind mounts
# <root>/rnd and <root>/qa read only at /mnt/nas/rnd and /mnt/nas/qa, and the mounts are
# always present: the default points at the tracked sample tree chris-local/nas-sample
# so the wiring can be exercised without a NAS.
#
# Setting this variable does one more thing: start-gateway.sh then makes the department
# agents' workspaces those read-only mounts, which is what turns rnd-bot and qa-bot into
# read-only file servers over the shares. Leave it empty and they keep their own writable
# workspaces under the state directory. Read AUTH-DEPARTMENTS.md 13.7 before setting it:
# a read-only workspace also switches those two agents' workspace bootstrap files off.
# "main" keeps a writable workspace and is unaffected.
#
# In a real delivery this is an absolute path on the host where the SMB (cifs) or NFS
# shares are already mounted, for example /srv/nas. Mount procedure: DEPLOY.md 11.4.
OPENCLAW_NAS_ROOT=

# Parent directory of the Markdown sidecar indexes on the host. Empty by default, which
# leaves the department agents searching only their own memory. The memory indexer
# collects Markdown and nothing else, so a share full of pdf, docx, xlsx and pptx files
# becomes searchable only after "openclaw knowledge sync" writes a sidecar for each file
# into <this>/<department>. Compose mounts those folders writable at /mnt/knowledge/<dept>
# and start-gateway.sh puts them in each agent's memory.search.extraPaths.
#
# Keep this off the NAS. The share is mounted read only, and the whole point of a
# host-local index is that indexing never writes back to it. Procedure: KNOWLEDGE.md.
OPENCLAW_KNOWLEDGE_ROOT=

# ── Models ──
# Leave both empty for an on-premises deployment that answers from the internal
# ollama service only. Fill one in to reach an external API instead; the Gateway reads
# these names directly, and the tracked config can also point at them with a
# "${ANTHROPIC_API_KEY}" reference so the file records which key a deployment uses
# without ever holding its value. Setup procedure: DEPLOY.md 3.4.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
