# Copy to chris-local/ixauth.env and fill in. That file is git-ignored.
#
# Generate the two secrets with:
#   openssl rand -base64 36 | tr -d '\n'

IXAUTH_DB_NAME=ixauth
IXAUTH_DB_USERNAME=ixauth
IXAUTH_DB_PASSWORD=

# 32 characters or more. The identity server refuses to boot with a shorter key.
# This is the app-to-server shared secret; it never reaches a browser.
IXAUTH_SERVICE_KEY=

# Must match gateway.auth.ixAuth.issuer and .audience exactly.
IXAUTH_JWT_ISSUER=https://gateway.example
IXAUTH_JWT_AUDIENCE=openclaw

# Seeded on first boot only. Change the password after the first sign-in.
IXAUTH_ADMIN_EMAIL=admin@example.com
IXAUTH_ADMIN_PASSWORD=

# Where mail links point. This is the Gateway address, not the identity server's.
IXAUTH_PUBLIC_APP_URL=https://gateway.example

# CLOSED keeps signup off and leaves account creation to administrators.
# OPEN or APPROVAL need working mail first.
IXAUTH_ACCOUNT_SIGNUP_MODE=CLOSED

# LOG writes the message to the server log instead of sending it, which keeps
# invitations testable before SMTP exists. Switch to SMTP for real deployments.
IXAUTH_MAIL_TRANSPORT=LOG

OPENCLAW_GATEWAY_PORT=18789
